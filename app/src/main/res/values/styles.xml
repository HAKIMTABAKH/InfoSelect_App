<resources>

    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Customize your theme here -->
        <item name="colorPrimary">@color/gris</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/blue</item>
    </style>

    <!-- Custom style for TextInputLayout -->
    <style name="CustomTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <!-- Remove the border stroke color -->
        <item name="boxStrokeColor">@android:color/transparent</item>
        <!-- Remove the default background -->
        <item name="boxBackgroundMode">none</item>
        <!-- Customize the hint text appearance -->
        <item name="hintTextAppearance">@style/CustomHintTextAppearance</item>
    </style>

    <!-- Custom hint text appearance -->
    <style name="CustomHintTextAppearance" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/blue</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>
